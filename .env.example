# ---- Database ----
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/a11y-monitor?retryWrites=true&w=majority"

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Email (Resend) ----
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="A11y Monitor <noreply@yourdomain.com>"
EMAIL_TO="team@yourdomain.com"
ENABLE_EMAIL="false"

# ---- Scanning ----
# Cron expression for automated scans (default: every Monday at 2am)
SCAN_SCHEDULE="0 2 * * 1"
MAX_CONCURRENT_SCANS="3"
