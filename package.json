{
  "name": "accessibility-monitor",
  "version": "1.0.0",
  "description": "Automated accessibility monitoring platform using Playwright and Axe-core",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "scan": "node src/cli.js scan",
    "scan:all": "node src/cli.js scan-all",
    "init-db": "node src/database/init.js",
    "import-sites": "node src/utils/import-sites.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "keywords": [
    "accessibility",
    "wcag",
    "axe-core",
    "playwright",
    "a11y"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@axe-core/playwright": "^4.9.0",
    "express": "^4.18.2",
    "sql.js": "^1.10.3",
    "node-cron": "^3.0.3",
    "playwright": "^1.42.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "uuid": "^9.0.1",
    "json2csv": "^6.0.0-alpha.2",
    "nodemailer": "^6.9.10",
    "chart.js": "^4.4.1",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
